# ============ 前端 / 静态产物 ============
ClientWeb/dist/
ClientWeb/node_modules/
ClientWeb/tsconfig.tsbuildinfo
ServerGo/static/

# ============ Protocol Buffers 生成代码 ============
# 源文件在 proto/，产物由 proto/gen.sh 生成
ServerGo/proto/pb/
ClientWeb/src/proto/

# ============ 安全：运行时配置（含密钥） ============
# 仅提交根目录的 LsmAgentGame.conf.example（占位符值）
LsmAgentGame.conf
# 子目录里为跑 go test 建的 .example 符号链接（config.Load 需同级文件，见 §197）
ServerGo/**/LsmAgentGame.conf.example

# ============ 安全：TLS 私钥 / 证书 ============
# 任何 *.crt/*.key/*.pem 都不要入库（含 server.crt / server.key 及 .new 变体）
*.crt
*.key
*.pem

# ============ 安全：测试账号 / 凭据文件 ============
test_account.json
accounts.json
credentials.json
.env
.env.*
!.env.example

# ============ AI Agent 工作目录 ============
# 仅本机使用,不提交
.agent_work/

# ============ OpenClaw Agent workspace 引导文件 ============
# 自动化脚本(Auto*.sh)随机选中 openclaw agent 时,首次运行会在
# workspace(项目根)自动生成这些身份/状态模板,仅本机使用,不提交
SOUL.md
IDENTITY.md
USER.md
TOOLS.md
HEARTBEAT.md
openclaw-workspace-state.json

# ============ 自动化测试产物 ============
# 逐文件追加极易漏,一律整目录忽略（§22：报告处理完即删,不在仓库长期堆积）
AutoTestProgress/
AutoTestScreenshots/
TestReport/*
!TestReport/.gitkeep

